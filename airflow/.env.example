# Copy to .env (same folder) before running `docker compose up`. .env is gitignored.

# Host folder holding your gcloud credentials, mounted into the containers so
# gcloud / gsutil / bq are authenticated. Use FORWARD SLASHES on Windows.
#   Windows : C:/Users/<you>/AppData/Roaming/gcloud
#   macOS/Linux: ${HOME}/.config/gcloud
GCLOUD_CONFIG_DIR=C:/Users/vishn/AppData/Roaming/gcloud

# Connection string to the app's source Postgres on the host (the scraped jobs).
# host.docker.internal resolves to the host from inside the containers.
DATABASE_URL=postgresql://postgres:project@host.docker.internal:5432/jobmarket

# Airflow UI login (created by airflow-init).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# On Linux set this to your host UID (`id -u`) so mounted files stay writable.
# On Docker Desktop (Windows/macOS) the default is fine.
AIRFLOW_UID=50000
